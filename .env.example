# Real shared game leaderboards (optional — the games work without this,
# scores just stay local to each visitor's browser until it's set up).
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in that project's SQL Editor
# 3. Project Settings → API → copy the "Project URL" and "anon public" key below
# 4. Add the same two values in Vercel: Project → Settings → Environment
#    Variables (so the live site picks them up too)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
